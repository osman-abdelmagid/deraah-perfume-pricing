	partition fact_perfumes = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "fact_perfumes.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    Typed = Table.TransformColumnTypes(Promoted, {{"house", type text}, {"sub_brand", type text}, {"product_id", type text}, {"product_name", type text}, {"gender", type text}, {"size_value", type number}, {"size_unit", type text}, {"units_in_pack", Int64.Type}, {"price_sar", type number}, {"list_price_sar", type number}, {"on_markdown", type logical}, {"discount_pct", type number}, {"promo_type", type text}, {"effective_discount", type number}, {"price_per_ml", type number}, {"list_price_per_ml", type number}, {"eff_price_per_ml", type number}, {"ppm_band", type text}, {"price_band_sar", type text}, {"url", type text}, {"scrape_date", type text}, {"promo_ar", type text}, {"is_bundle", type logical}, {"sub_brand_ar", type text}}, "en-US")
				in
				    Typed

	annotation PBI_ResultType = Table

