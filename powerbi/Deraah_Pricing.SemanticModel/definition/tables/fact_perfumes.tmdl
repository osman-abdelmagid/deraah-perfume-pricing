table fact_perfumes
	lineageTag: 358a8e0f-8555-442f-a428-19cd0e458887

	measure Perfumes = COUNTROWS ( fact_perfumes )
		formatString: #,0
		lineageTag: df123165-a667-416f-bd2f-1408d54d15a7

	measure 'Perfumes Priced per ml' = CALCULATE ( COUNTROWS ( fact_perfumes ), NOT ISBLANK ( fact_perfumes[price_per_ml] ) )
		formatString: #,0
		lineageTag: 48a1ac06-c961-466d-be04-aebde614399a

	measure 'Median Price per ml' = MEDIAN ( fact_perfumes[price_per_ml] )
		formatString: 0.00
		lineageTag: 80d5f02c-0237-45a0-801d-0af18c87e385

	measure 'Median Price per ml after Bundles' = MEDIAN ( fact_perfumes[eff_price_per_ml] )
		formatString: 0.00
		lineageTag: 58497628-eb62-4d4b-9544-258aac9e03d0

	measure 'Median List Price per ml' = MEDIAN ( fact_perfumes[list_price_per_ml] )
		formatString: 0.00
		lineageTag: 7d4d2573-3d50-47c7-99a8-dac334ad6fc0

	measure 'P25 Price per ml' = PERCENTILEX.INC ( FILTER ( fact_perfumes, NOT ISBLANK ( fact_perfumes[price_per_ml] ) ), fact_perfumes[price_per_ml], 0.25 )
		formatString: 0.00
		lineageTag: 5d920693-9846-4d23-a30b-2c611443349d

	measure 'P75 Price per ml' = PERCENTILEX.INC ( FILTER ( fact_perfumes, NOT ISBLANK ( fact_perfumes[price_per_ml] ) ), fact_perfumes[price_per_ml], 0.75 )
		formatString: 0.00
		lineageTag: 1e551325-d736-4e73-b4c6-69b1d2d40238

	measure 'Min Price per ml' = MIN ( fact_perfumes[price_per_ml] )
		formatString: 0.00
		lineageTag: 40ff793e-c587-492d-ae74-be4366311f28

	measure 'Max Price per ml' = MAX ( fact_perfumes[price_per_ml] )
		formatString: 0.00
		lineageTag: 08b3608a-1fac-40d4-aa19-b27dbbb0d250

	measure 'Median Price 100ml' = CALCULATE ( MEDIAN ( fact_perfumes[price_sar] ), fact_perfumes[size_value] = 100, NOT ISBLANK ( fact_perfumes[price_per_ml] ) )
		formatString: #,0
		lineageTag: 5a26c87b-5949-4223-ab4c-08da09db5259

	measure 'Share Under 1 SAR per ml' = DIVIDE ( CALCULATE ( [Perfumes], fact_perfumes[price_per_ml] < 1, NOT ISBLANK ( fact_perfumes[price_per_ml] ) ), [Perfumes Priced per ml] )
		formatString: 0%
		lineageTag: 597015e7-2c3f-41e4-9a50-2c6ec97ab75c

	measure 'Share Marked Down' = DIVIDE ( CALCULATE ( [Perfumes], fact_perfumes[on_markdown] = TRUE () ), [Perfumes] )
		formatString: 0%
		lineageTag: 8bb0af93-e7fe-4258-b18c-42391835b4dc

	measure 'Share with Bundle Offer' = DIVIDE ( CALCULATE ( [Perfumes], fact_perfumes[is_bundle] = TRUE () ), [Perfumes] )
		formatString: 0%
		lineageTag: 188ac287-e8dd-49d7-871d-0175fd3b9242

	measure 'Median Markdown Depth' = CALCULATE ( MEDIAN ( fact_perfumes[discount_pct] ), fact_perfumes[on_markdown] = TRUE () )
		formatString: 0%
		lineageTag: 552ebd5d-4854-4e20-8b0e-368b21ae88a4

	measure 'Median Effective Discount' = MEDIAN ( fact_perfumes[effective_discount] )
		formatString: 0%
		lineageTag: bfac3bca-5e3d-459d-bac9-f619d821018e

	measure 'Share of House Perfumes' = DIVIDE ( [Perfumes Priced per ml], CALCULATE ( [Perfumes Priced per ml], REMOVEFILTERS ( dim_ppm_band ) ) )
		formatString: 0%
		lineageTag: 9ec5c6b2-89ea-4419-a66a-55db8a38b47a

